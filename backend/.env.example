# Copiar a .env (nunca subir el .env real al repositorio) y completar por ambiente.
# Ver planificacion/17-infraestructura-y-entornos.md — Desarrollo y Producción usan
# archivos .env separados, apuntando a bases de datos distintas.

ENTORNO=desarrollo
DATABASE_URL=postgresql://logos_dev:logos_dev_local@localhost:5432/logos_dev
JWT_SECRET=cambiar-por-un-valor-aleatorio-largo
JWT_ALGORITMO=HS256
JWT_EXPIRACION_MINUTOS=720

# Rate limiting — sin definir, cada uno usa su valor de producción (ver
# app/core/config.py). Subir estos valores SOLO en el .env de Desarrollo (nunca en el de
# Producción) si la suite de tests E2E choca con el límite real.
# LIMITE_REGISTRO_POR_MINUTO=5
# LIMITE_LOGIN_POR_MINUTO=10
# LIMITE_GLOBAL_POR_MINUTO=300              # red de seguridad por defecto, cualquier endpoint
# LIMITE_ADMIN_LOGIN_POR_MINUTO=5
# LIMITE_REGISTRO_PROFESOR_POR_MINUTO=5
# LIMITE_LOGIN_PROFESOR_POR_MINUTO=10
# LIMITE_AGREGAR_ALUMNO_POR_MINUTO=10
# LIMITE_SUGERENCIA_POR_MINUTO=5
# LIMITE_REPORTAR_ERROR_POR_MINUTO=10
# LIMITE_COMUNICADO_POR_MINUTO=10

# Login con Google — crear un Client ID en Google Cloud Console (OAuth consent screen)
GOOGLE_CLIENT_ID=

# Correo transaccional — crear una cuenta NUEVA en resend.com propia de este proyecto
RESEND_API_KEY=
RESEND_REMITENTE="Logos <no-responder@logos.cl>"
