# Copiar a .env (nunca subir el .env real al repositorio) y completar por ambiente.
# Ver planificacion/17-infraestructura-y-entornos.md — Desarrollo y Producción usan
# archivos .env separados, apuntando a bases de datos distintas.

ENTORNO=desarrollo
DATABASE_URL=postgresql://logos_dev:logos_dev_local@localhost:5432/logos_dev
JWT_SECRET=cambiar-por-un-valor-aleatorio-largo
JWT_ALGORITMO=HS256
JWT_EXPIRACION_MINUTOS=720

# Login con Google — crear un Client ID en Google Cloud Console (OAuth consent screen)
GOOGLE_CLIENT_ID=

# Correo transaccional — crear una cuenta NUEVA en resend.com propia de este proyecto
RESEND_API_KEY=
RESEND_REMITENTE="Logos <no-responder@logos.cl>"
